# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Python packaging and build artifacts
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/
wheelhouse/

# Virtual environments
.venv/
venv/
env/
ENV/

