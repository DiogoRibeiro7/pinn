# https://editorconfig.org — keeps whitespace consistent across editors.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Matches [tool.black] line-length in pyproject.toml.
[*.py]
max_line_length = 88

[*.{yml,yaml,json,toml,cff}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# Notebooks are machine-generated JSON; leave their formatting alone.
[*.ipynb]
insert_final_newline = false
trim_trailing_whitespace = false
