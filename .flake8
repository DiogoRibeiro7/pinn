; flake8 does not read pyproject.toml, so its configuration lives here.
; Keep max-line-length in sync with [tool.black] in pyproject.toml.
[flake8]
max-line-length = 88
extend-ignore =
    ; whitespace before ':' — disagrees with black on slices
    E203,
    ; line break before binary operator — black's preferred style
    W503,
    ; line too long — black is the authority on line length and already
    ; reformats everything it can to 88 columns. What survives is string
    ; literals, URLs and comments that black cannot split, where the
    ; remaining violations are typically one or two characters over and
    ; wrapping them by hand hurts readability more than it helps.
    E501
exclude =
    .git,
    __pycache__,
    .mypy_cache,
    .pytest_cache,
    .benchmarks,
    .hypothesis,
    build,
    dist,
    *.egg-info,
    .venv,
    venv,
    docs/_build,
    notebooks
per-file-ignores =
    ; re-exported names are intentionally unused in package __init__ files
    __init__.py: F401
